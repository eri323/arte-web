---
import '../styles/global.css';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { negocio } from '../config/negocio';
import { CLAVE_COLORES } from '../stores/marca';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og/inicio.png' } = Astro.props;
const tituloCompleto = `${title} · ${negocio.marca.nombre}`;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

const variablesMarca = Object.entries(negocio.marca.colores)
  .map(
    ([clave, valor]) =>
      `--marca-${clave.replace(/[A-Z]/g, (l) => `-${l.toLowerCase()}`)}: ${valor};`,
  )
  .join(' ');
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={negocio.marca.colores.fondo} />
    <style set:html={`:root { ${variablesMarca} }`}></style>
    <!-- Tema claro u oscuro antes de pintar, para que no parpadee. -->
    <script is:inline>
      (() => {
        let guardado = null;
        try {
          guardado = localStorage.getItem('arte-web:tema');
        } catch {
          // Sin localStorage se sigue el tema del sistema.
        }
        const sistema = window.matchMedia('(prefers-color-scheme: dark)');
        const aplicar = (tema) => {
          document.documentElement.dataset.tema = tema;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', tema === 'oscuro' ? '#161513' : '#f2f2f0');
        };
        aplicar(guardado || (sistema.matches ? 'oscuro' : 'claro'));
        // Si el cliente nunca eligió, el sitio sigue al sistema aunque cambie con la página abierta.
        if (!guardado) {
          sistema.addEventListener('change', (e) => aplicar(e.matches ? 'oscuro' : 'claro'));
        }
      })();
    </script>
    <!-- Con JS las secciones esperan a entrar en pantalla para aparecer; sin JS se ven quietas. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <!-- Colores elegidos en el panel del taller: se aplican antes de pintar para que no parpadee. -->
    <script is:inline define:vars={{ clave: CLAVE_COLORES }}>
      try {
        const c = JSON.parse(localStorage.getItem(clave) || 'null');
        if (c && typeof c === 'object') {
          for (const [k, v] of Object.entries(c)) {
            if (typeof v === 'string' && /^#[0-9a-f]{6}([0-9a-f]{2})?$/i.test(v)) {
              const nombre = '--marca-' + k.replace(/[A-Z]/g, (l) => '-' + l.toLowerCase());
              document.documentElement.style.setProperty(nombre, v);
            }
          }
        }
      } catch {
        // Sin localStorage o con datos dañados se quedan los colores de negocio.ts.
      }
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Cada .aparece se marca .visto la primera vez que entra en pantalla (una sola vez).
      const marcar = (el: Element) => el.classList.add('visto');
      const piezas = document.querySelectorAll('.aparece');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              marcar(e.target);
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        piezas.forEach((el) => io.observe(el));
      } else {
        piezas.forEach(marcar);
      }
    </script>
  </body>
</html>
