---
import { negocio } from '../../config/negocio';

const { instagram } = negocio.redes;
const claseEnlace =
  'text-texto no-underline [background:linear-gradient(currentColor,currentColor)_no-repeat_0_100%/100%_1px]';
---

<footer class="noche border-t border-linea">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-3 px-4 py-7 text-[0.8125rem] text-texto-suave sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
    <div>
      <img src="/logo.png" alt="" width="285" height="210" class="logo-marca mb-4 h-16 w-auto" />
      <p>{negocio.marca.eslogan}</p>
      {instagram && (
        <p class="mt-1">
          Instagram{' '}
          <a
            href={`https://www.instagram.com/${instagram}/`}
            target="_blank"
            rel="noopener"
            class={claseEnlace}
          >
            @{instagram}
          </a>
        </p>
      )}
    </div>
    <div class="flex flex-col gap-1 sm:items-end">
      <a href="/taller#colores" class={claseEnlace}>
        Prueba otros colores de marca
      </a>
      <p class="lapiz">Demo · propuesta web</p>
    </div>
  </div>
</footer>
