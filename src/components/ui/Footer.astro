---
import { negocio } from '../../config/negocio';
---

<footer class="border-t border-linea">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-texto-suave sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-display text-2xl text-texto">{negocio.marca.nombre}</p>
      <p class="mt-1">{negocio.marca.eslogan}</p>
    </div>
    <div class="flex flex-col gap-1 sm:items-end">
      <a href="/taller#colores" class="font-semibold text-texto underline underline-offset-4">
        Prueba otros colores de marca
      </a>
      <p class="lapiz">Demo · marca ficticia</p>
    </div>
  </div>
</footer>
