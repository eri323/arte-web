---
import { negocio } from '../../config/negocio';
import ContadorCarrito from '../pedido/ContadorCarrito';

const claseEnlace =
  'flex min-h-11 items-center px-2 text-sm whitespace-nowrap text-texto hover:text-dorado';
---

<header class="border-b border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-2 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="flex min-h-11 items-center font-serif text-2xl font-semibold text-dorado">
      {negocio.marca.nombre}
    </a>
    <nav aria-label="Principal" class="-mx-2 overflow-x-auto">
      <ul class="flex">
        <li>
          <a href="/formatos" class={claseEnlace}>
            Formatos
          </a>
        </li>
        <li>
          <a href="/crear" class={claseEnlace}>
            Crear
          </a>
        </li>
        <li>
          <ContadorCarrito client:idle className={claseEnlace} />
        </li>
        <li>
          <a href="/seguimiento" class={claseEnlace}>
            Seguimiento
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
