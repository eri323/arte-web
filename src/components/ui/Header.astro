---
import { negocio } from '../../config/negocio';
import { urlWhatsApp } from '../../lib/whatsapp';
import ContadorCarrito from '../pedido/ContadorCarrito';

// Enlaces grises con una raya de 1 px que crece al pasar el cursor.
const claseEnlace =
  'flex min-h-11 items-center px-2 text-sm font-medium whitespace-nowrap text-texto-suave transition-[color,background-size] duration-300 hover:text-texto [background:linear-gradient(var(--color-acento),var(--color-acento))_no-repeat_8px_calc(50%+0.8em)/0_2px] hover:[background-size:calc(100%-16px)_2px]';

// El botón de WhatsApp abre el chat del taller con el saludo ya escrito.
// SUPUESTO: en modo demo (sin número en negocio.ts) abre WhatsApp con el mismo saludo y deja
// elegir el contacto, para que el botón se pueda probar; con el número real va directo al taller.
const saludo = `Hola ${negocio.marca.nombre}, quiero un póster`;
const chat =
  urlWhatsApp(negocio.whatsapp.numero, saludo) ??
  `https://wa.me/?text=${encodeURIComponent(saludo)}`;

const enlaces = [
  { href: '/#catalogo', texto: 'Catálogo' },
  { href: '/crear', texto: 'Personalizados' },
  { href: '/formatos', texto: 'Medidas y precios' },
  { href: '/seguimiento', texto: 'Seguimiento' },
];
---

<header class="relative z-50 border-b border-linea bg-fondo/92 backdrop-blur-md sm:sticky sm:top-0">
  {/* En el celular: logo y pedido arriba, enlaces debajo con scroll lateral. */}
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-4 px-4 lg:min-h-16 lg:flex-nowrap">
    <a href="/" class="order-1 flex min-h-14 items-center gap-3 text-texto">
      {/* El logo real del taller: tinta negra con transparencia (se invierte en oscuro). */}
      <img
        src="/logo.png"
        alt={negocio.marca.nombre}
        width="285"
        height="210"
        data-logo
        class="logo-marca h-11 w-auto"
      />
    </a>
    <nav
      aria-label="Principal"
      data-nav-desliza
      class="nav-desliza order-3 -mx-2 w-[calc(100%+1rem)] overflow-x-auto [scrollbar-width:none] lg:order-2 lg:mx-0 lg:ml-auto lg:w-auto"
    >
      <ul class="flex items-center lg:gap-3">
        {enlaces.map((e) => (
          <li>
            <a href={e.href} class={claseEnlace}>
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="order-2 ml-auto flex items-center gap-1 lg:order-3 lg:ml-2">
      <button
        type="button"
        data-cambiar-tema
        aria-label="Modo oscuro"
        aria-pressed="false"
        class="presionable grid size-11 place-items-center rounded-full text-texto-suave transition-colors hover:text-texto"
      >
        {/* Luna (modo claro) y sol (modo oscuro); el CSS muestra solo el que toca. */}
        <svg
          class="icono-luna size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
        </svg>
        <svg
          class="icono-sol size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>
      </button>
      <a
        href={chat}
        target="_blank"
        rel="noopener"
        aria-label="Escribir por WhatsApp"
        data-whatsapp
        class="presionable flex size-11 items-center justify-center gap-2 rounded-full text-sm font-medium text-texto-suave transition-colors hover:text-texto sm:mr-1 sm:w-auto sm:px-3"
      >
        <svg class="size-[22px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.4-.2-2.8.7.8-2.7-.3-.4A8.2 8.2 0 0 1 12 3.8Zm-3.3 3.9c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.300 0 1.400 1 2.700 1.200 2.900.1.2 2 3.100 4.900 4.300 2.400 1 2.900.8 3.400.7.5 0 1.700-.7 1.900-1.300.2-.700.2-1.200.2-1.300-.1-.2-.3-.2-.6-.4l-1.900-.9c-.3-.1-.5-.2-.7.1l-.9 1.100c-.2.2-.3.2-.6.100-.3-.2-1.200-.5-2.300-1.400-.9-.8-1.400-1.700-1.600-2-.2-.3 0-.5.1-.600l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.100c-.2-.5-.4-.5-.6-.5h-.5Z"></path>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
      </a>
      <ContadorCarrito client:idle className="boton boton-negro min-h-10 px-4 py-2 text-sm" />
    </div>
  </div>
</header>

<style>
  /* En el celular los enlaces no caben: el borde que tiene más enlaces escondidos
     se desvanece para que se note que se puede deslizar. Sin JS queda el del lado derecho. */
  .nav-desliza {
    --izq: 0px;
    --der: 2.5rem;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--izq),
      #000 calc(100% - var(--der)),
      transparent
    );
  }
  .nav-desliza[data-inicio='false'] {
    --izq: 2.5rem;
  }
  .nav-desliza[data-fin='true'] {
    --der: 0px;
  }
  @media (min-width: 64rem) {
    .nav-desliza {
      mask-image: none;
    }
  }
</style>

<script>
  // Marca si el menú está al inicio o al final del scroll para ajustar el desvanecido.
  const nav = document.querySelector<HTMLElement>('[data-nav-desliza]');
  const medirNav = () => {
    if (!nav) return;
    nav.dataset.inicio = String(nav.scrollLeft <= 1);
    nav.dataset.fin = String(nav.scrollLeft + nav.clientWidth >= nav.scrollWidth - 1);
  };
  medirNav();
  nav?.addEventListener('scroll', medirNav, { passive: true });
  window.addEventListener('resize', medirNav);
</script>

<script>
  // El botón cambia entre claro y oscuro y recuerda la elección en este navegador.
  const boton = document.querySelector<HTMLButtonElement>('[data-cambiar-tema]');
  const raiz = document.documentElement;
  const sincronizar = () =>
    boton?.setAttribute('aria-pressed', String(raiz.dataset.tema === 'oscuro'));
  sincronizar();
  new MutationObserver(sincronizar).observe(raiz, { attributeFilter: ['data-tema'] });
  boton?.addEventListener('click', () => {
    const tema = raiz.dataset.tema === 'oscuro' ? 'claro' : 'oscuro';
    raiz.dataset.tema = tema;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', tema === 'oscuro' ? '#17181b' : '#efefec');
    try {
      localStorage.setItem('arte-web:tema', tema);
    } catch {
      // Sin localStorage el tema dura hasta recargar.
    }
  });
</script>
