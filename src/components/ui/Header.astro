---
import { negocio } from '../../config/negocio';
import ContadorCarrito from '../pedido/ContadorCarrito';

// Enlaces grises con una raya de 1 px que crece al pasar el cursor.
const claseEnlace =
  'flex min-h-11 items-center px-2 text-[0.8125rem] whitespace-nowrap text-texto-suave transition-[color,background-size] duration-300 hover:text-texto [background:linear-gradient(var(--color-texto),var(--color-texto))_no-repeat_8px_calc(50%+0.8em)/0_1px] hover:[background-size:calc(100%-16px)_1px]';

const enlaces = [
  { href: '/#catalogo', texto: 'Inspiración' },
  { href: '/#pared', texto: 'Ver en tu pared' },
  { href: '/formatos', texto: 'Formatos' },
  { href: '/crear', texto: 'Crear' },
  { href: '/seguimiento', texto: 'Seguimiento' },
];
---

<header class="relative z-50 border-b border-linea bg-fondo/92 backdrop-blur-md sm:sticky sm:top-0">
  {/* En el celular: logo y pedido arriba, enlaces debajo con scroll lateral. */}
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-4 px-4 lg:min-h-16 lg:flex-nowrap">
    <a href="/" class="order-1 flex min-h-14 items-center gap-3 text-texto">
      {/* El sol de rayos del logo, dibujado con CSS. */}
      <span
        aria-hidden="true"
        data-logo
        class="size-[26px] shrink-0 rounded-full [background:repeating-conic-gradient(var(--color-acento)_0_8deg,var(--color-texto)_8deg_20deg)]"
      ></span>
      <span class="text-[0.9375rem] font-semibold tracking-[0.14em] whitespace-nowrap uppercase sm:text-base">
        {negocio.marca.nombre}
      </span>
    </a>
    <nav
      aria-label="Principal"
      class="order-3 -mx-2 w-[calc(100%+1rem)] overflow-x-auto [scrollbar-width:none] lg:order-2 lg:mx-0 lg:ml-auto lg:w-auto"
    >
      <ul class="flex items-center lg:gap-3">
        {enlaces.map((e) => (
          <li>
            <a href={e.href} class={claseEnlace}>
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="order-2 ml-auto lg:order-3 lg:ml-2">
      <ContadorCarrito
        client:idle
        className="boton boton-linea min-h-10 px-4 py-2 text-[0.8125rem]"
      />
    </div>
  </div>
</header>
