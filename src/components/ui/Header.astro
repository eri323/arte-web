---
import { negocio } from '../../config/negocio';
import ContadorCarrito from '../pedido/ContadorCarrito';

const claseEnlace =
  'flex min-h-11 items-center px-2 text-[0.9375rem] font-medium whitespace-nowrap text-texto underline-offset-[6px] decoration-2 hover:underline hover:decoration-acento';
---

<header class="border-b border-linea bg-fondo">
  <div class="mx-auto flex max-w-6xl flex-col px-4 sm:min-h-14 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="font-display flex min-h-11 items-center text-xl tracking-tight">
      {negocio.marca.nombre}
    </a>
    <nav aria-label="Principal" class="-mx-2 overflow-x-auto">
      <ul class="flex">
        <li>
          <a href="/formatos" class={claseEnlace}>
            Formatos
          </a>
        </li>
        <li>
          <a href="/crear" class={claseEnlace}>
            Crear
          </a>
        </li>
        <li>
          <ContadorCarrito client:idle className={claseEnlace} />
        </li>
        <li>
          <a href="/seguimiento" class={claseEnlace}>
            Seguimiento
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
