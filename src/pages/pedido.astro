---
import Base from '../layouts/Base.astro';
import Pedido from '../components/pedido/Pedido';
---

<Base
  title="Tu pedido"
  description="Revisa tus cuadros, el desglose con promociones, el abono y el saldo, y envía tu pedido por WhatsApp."
  ogImage="/og/pedido.png"
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-16">
    <h1 class="mb-8 font-display text-4xl font-semibold text-acento-fuerte sm:text-5xl">
      Tu pedido
    </h1>
    <Pedido client:load />
  </section>
</Base>
