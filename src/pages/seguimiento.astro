---
import Base from '../layouts/Base.astro';
import Seguimiento from '../components/seguimiento/Seguimiento';
---

<Base
  title="Seguimiento de tu pedido"
  description="Consulta con tu número de pedido el estado de tu cuadro, los pagos, el saldo y las notas del taller."
  ogImage="/og/seguimiento.png"
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-16">
    <h1 class="mb-6 font-display text-4xl font-semibold text-acento-fuerte sm:text-5xl">
      ¿En qué va mi cuadro?
    </h1>
    <Seguimiento client:load />
  </section>
</Base>
