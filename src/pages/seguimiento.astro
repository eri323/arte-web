---
import Base from '../layouts/Base.astro';
import Seguimiento from '../components/seguimiento/Seguimiento';
---

<Base
  title="Seguimiento de tu pedido"
  description="Consulta con tu número de pedido el estado de tu póster, los pagos, el saldo y las notas del taller."
  ogImage="/og/seguimiento.png"
>
  <section class="mx-auto max-w-[1240px] px-4 pt-[clamp(32px,5vw,64px)] pb-16">
    <h1 class="titulo-seccion mb-6">¿En qué va mi póster?</h1>
    <Seguimiento client:load />
  </section>
</Base>
