---
import Base from '../layouts/Base.astro';
import Poster from '../components/catalogo/Poster';
import Vitrina from '../components/catalogo/Vitrina';
import { negocio } from '../config/negocio';
import { etiquetaMedida, formatearPesos } from '../lib/formato';
import { urlWhatsApp } from '../lib/whatsapp';

const { vitrina, catalogo, entregas, envio, tiempos } = negocio;

// La parrilla de la portada: siete pósters verticales en dos alturas. En el celular se ven los
// tres del centro y medio de cada vecino.
const parrilla = [
  'nissan-gtr-r35',
  'senna-monaco-1990',
  'mclaren-720s',
  'ferrari-488-pista',
  'antonelli-w17',
  'ducati-panigale',
  'nordschleife',
]
  .map((id) => catalogo.find((d) => d.id === id))
  .filter((d) => d !== undefined);

const deCatalogo = negocio.medidas.filter((m) => m.linea === 'catalogo');
const personalizadas = negocio.medidas.filter((m) => m.linea === 'personalizado');
const porArea = [...deCatalogo].sort((a, b) => a.anchoCm * a.altoCm - b.anchoCm * b.altoCm);
const menor = porArea[0]!;
const mayor = porArea[porArea.length - 1]!;
const desdePersonalizado = Math.min(...personalizadas.map((m) => m.precio));
const abono = negocio.pagos.porcentajeAbono;

// La fila de datos bajo la portada, como la ficha técnica de sus pósters.
const ficha = [
  { dato: 'Medidas', valor: `${etiquetaMedida(menor)} a ${etiquetaMedida(mayor)} cm` },
  { dato: 'Entrega', valor: '3 a 4 días' },
  { dato: 'Envío a todo Colombia', valor: 'Desde $8.000' },
  { dato: 'Para empezar', valor: `Abono del ${abono}%` },
];

// Es una secuencia de verdad: cada paso depende del anterior.
// SUPUESTO: el saldo se paga antes del envío (el catálogo solo habla del abono del 50%).
const pasos = [
  {
    titulo: 'Nos cuentas cuál es',
    texto: 'Marca, modelo, color y los detalles que lo hacen tuyo. Las fotos van por WhatsApp.',
  },
  {
    titulo: `Abonas el ${abono}%`,
    texto: 'Con el abono sobre la medida que elijas arranca el diseño.',
  },
  {
    titulo: 'Lo ilustramos y lo enmarcamos',
    texto: `Hecho a mano, en digital. ${tiempos.texto}. ${tiempos.grande}.`,
  },
  {
    titulo: 'Te llega listo para colgar',
    texto: 'Pagas el saldo y lo enviamos a tu ciudad.',
  },
];

const preguntas = [
  {
    p: '¿Cómo llega el póster?',
    r: 'Enmarcado en negro, con vidrio o acrílico al frente según la medida, y listo para colgar.',
  },
  {
    p: '¿Cuánto se demora?',
    r: `${tiempos.texto}, según la cantidad de pedidos. ${tiempos.grande}.`,
  },
  {
    p: '¿Pueden hacer mi carro o mi moto?',
    r: `Sí. Ilustramos el vehículo que quieras, el tuyo o el de tus sueños, con los detalles y la perspectiva que elijas. Los personalizados van desde ${formatearPesos(desdePersonalizado)} y se empiezan con un abono del ${abono}%.`,
  },
  {
    p: '¿Puedo cambiarle el color a un póster del catálogo?',
    r: 'Sí. Los modelos del catálogo son la base: los colores y los detalles se ajustan a tu gusto. Pregúntanos por tu favorito.',
  },
  {
    p: '¿Cuánto cuesta el envío?',
    r: `${envio.tarifas.map((t) => `${t.zona}: ${t.valor}`).join('. ')}.`,
  },
  {
    p: '¿Cómo sé en qué va mi pedido?',
    r: 'Con tu número de pedido consultas el estado, los pagos, el saldo y las notas del taller en la página de seguimiento.',
  },
];

// Con número de WhatsApp el botón del cierre abre el chat; en modo demo lleva a /crear.
const chat = urlWhatsApp(negocio.whatsapp.numero, `Hola ${negocio.marca.nombre}, quiero un póster`);
const seccion = 'py-[clamp(72px,9vw,128px)]';
const titular = [vitrina.titular, vitrina.titularSuave].filter(Boolean).join(' ');
---

<Base title="Pósters de carros y motos, enmarcados" description={`${titular} ${vitrina.bajada}`}>
  {/* 1 · Portada armada como uno de sus pósters: el nombre en letras enormes que se desvanecen
       y, montada encima, la fila de cuadros. */}
  <section aria-labelledby="portada-titulo" class="overflow-hidden pt-[clamp(20px,3vw,40px)]">
    <h1 id="portada-titulo" class="text-center">
      <span class="letras-poster block" aria-hidden="true">
        Tu carro
      </span>
      <span class="sr-only">{titular}</span>
    </h1>

    <ul
      class="parrilla relative -mt-[clamp(2.4rem,11vw,12rem)] [--pw:clamp(118px,34vw,150px)] sm:[--pw:clamp(120px,13.2vw,196px)]"
      aria-label="Pósters del catálogo"
    >
      {parrilla.map((diseno, i) => (
        <li style={`--i:${i}`}>
          <a href="#pared" data-diseno={diseno.id} class="block">
            <Poster diseno={diseno} decorativa cargar="eager" />
            <span class="sr-only">Ver {diseno.nombre} a escala</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mx-auto mt-[clamp(36px,5vw,64px)] grid max-w-[1240px] gap-x-12 gap-y-6 px-4 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-end">
      <p class="entra font-display text-[clamp(2.75rem,6.4vw,5.25rem)]" aria-hidden="true">
        {vitrina.titularSuave}
      </p>
      <div class="entra" style="--i:1">
        <p class="max-w-[52ch] text-[1.0625rem] text-texto-suave">{vitrina.bajada}</p>
        <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
          <a href="#catalogo" class="boton boton-negro">
            Ver el catálogo
          </a>
          <a href="/crear" class="boton boton-linea">
            Quiero el de mi carro
          </a>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-[clamp(40px,5vw,64px)] max-w-[1240px] px-4">
      <dl class="ficha">
        {ficha.map((f) => (
          <div>
            <dt>{f.dato}</dt>
            <dd>{f.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* 2 y 3 · Catálogo con filtros y la pared a escala (una isla: comparten el póster elegido). */}
  <Vitrina client:idle />

  {/* 4 · Personalizados, sobre asfalto. */}
  <section id="personalizados" aria-labelledby="personalizados-titulo" class="noche scroll-mt-16">
    <div class="piano" aria-hidden="true"></div>
    <div
      class:list={['mx-auto grid max-w-[1240px] gap-x-16 gap-y-12 px-4 lg:grid-cols-2', seccion]}
    >
      <div>
        <h2 id="personalizados-titulo" class="titulo-seccion">
          El tuyo, tal cual
        </h2>
        <p class="mt-5 max-w-[48ch] text-[1.0625rem] text-texto-suave">
          Ilustramos el vehículo que quieras, el tuyo o el de tus sueños, con los detalles y la
          perspectiva que elijas. Desde {formatearPesos(desdePersonalizado)}, enmarcado.
        </p>
        <ol class="mt-10 border-t border-linea-fuerte">
          {pasos.map((paso, i) => (
            <li class="grid grid-cols-[3.25rem_minmax(0,1fr)] gap-x-2 border-b border-linea py-5">
              <span
                aria-hidden="true"
                class="font-display text-[2rem] text-acento-fuerte tabular-nums"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="text-[1.0625rem] font-semibold">{paso.titulo}</h3>
                <p class="mt-1 max-w-[46ch] text-[0.9375rem] text-texto-suave">{paso.texto}</p>
              </div>
            </li>
          ))}
        </ol>
        <a href="/crear" class="boton boton-oro mt-9">
          Empezar el mío
        </a>
      </div>

      {/* Tres cuadros reales, ya enmarcados, escalonados. */}
      <ul class="grid grid-cols-3 items-start gap-3 sm:gap-5" aria-label="Pósters ya enmarcados">
        {entregas.slice(0, 3).map((foto, i) => (
          <li class:list={[i === 1 && 'mt-[18%]', i === 2 && 'mt-[36%]']}>
            <img
              src={foto.src}
              alt={foto.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[9/16] w-full rounded-[4px] object-cover"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 5 · En casa: fotos reales de su Instagram, en una tira que se desliza. */}
  <section id="clientes" aria-labelledby="clientes-titulo" class={seccion}>
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-end justify-between gap-x-10 gap-y-4 px-4">
      <h2 id="clientes-titulo" class="titulo-seccion">
        Así se ven en casa
      </h2>
      {negocio.redes.instagram && (
        <a
          href={`https://www.instagram.com/${negocio.redes.instagram}/`}
          target="_blank"
          rel="noopener"
          class="enlace-fuerte"
        >
          Más en @{negocio.redes.instagram}
        </a>
      )}
    </div>
    <ul
      class="mt-10 flex snap-x gap-3 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] sm:gap-5 xl:px-[max(1rem,calc((100vw-1240px)/2+1rem))]"
      aria-label="Fotos de pósters entregados"
      tabindex="0"
    >
      {entregas.slice(3).map((foto) => (
        <li class="w-[min(62vw,280px)] shrink-0 snap-start">
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[9/16] w-full rounded-[4px] object-cover"
          />
        </li>
      ))}
    </ul>
  </section>

  {/* 6 · Envíos y pagos: las tarifas reales, sin párrafos. */}
  <section aria-labelledby="envios" class:list={['border-t border-linea', seccion]}>
    <div class="mx-auto grid max-w-[1240px] gap-x-16 gap-y-10 px-4 lg:grid-cols-2">
      <div>
        <h2 id="envios" class="titulo-seccion">
          Envíos y pagos
        </h2>
        <p class="mt-5 max-w-[46ch] text-[1.0625rem] text-texto-suave">
          Empiezas con un abono del {abono}% y pagas el resto cuando esté listo. Cada pago queda
          registrado y lo ves en el{' '}
          <a href="/seguimiento" class="font-semibold text-texto underline underline-offset-4">
            seguimiento de tu pedido
          </a>
          .
        </p>
        <a href="/formatos" class="boton boton-linea mt-8">
          Ver medidas y precios
        </a>
      </div>
      <dl class="border-t-2 border-texto">
        {envio.tarifas.map((t) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-linea-fuerte py-4">
            <dt class="text-[1.0625rem]">{t.zona}</dt>
            <dd class="font-display text-[1.75rem] whitespace-nowrap tabular-nums">{t.valor}</dd>
          </div>
        ))}
        <div class="flex items-baseline justify-between gap-6 py-4">
          <dt class="text-[1.0625rem]">Tiempo de entrega</dt>
          <dd class="font-display text-[1.75rem] whitespace-nowrap">3 a 4 días</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* 7 · Preguntas frecuentes. */}
  <section aria-labelledby="faq" class:list={['border-t border-linea', seccion]}>
    <div class="mx-auto grid max-w-[1240px] gap-8 px-4 md:grid-cols-[1fr_1.6fr]">
      <h2 id="faq" class="titulo-seccion">
        Preguntas frecuentes
      </h2>
      <div class="divide-y divide-linea border-y border-linea">
        {preguntas.map(({ p, r }) => (
          <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[1.0625rem] font-semibold [&::-webkit-details-marker]:hidden">
              {p}
              <span
                aria-hidden="true"
                class="text-2xl font-normal transition-transform duration-300 ease-(--ease-suave) group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="max-w-[60ch] pb-5 text-texto-suave">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* 8 · Cierre, sobre asfalto. */}
  <section aria-labelledby="cierre" class="noche">
    <div class="piano" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-4 py-[clamp(72px,10vw,136px)]">
      <h2 id="cierre" class="font-display text-[clamp(3.25rem,10vw,9rem)]">
        ¿Cuál es el tuyo?
      </h2>
      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-[44ch] text-[1.0625rem] text-texto-suave">
          Dinos qué carro o qué moto quieres en la pared y de qué medida.
        </p>
        {chat ? (
          <a href={chat} target="_blank" rel="noopener" class="boton boton-oro">
            Escribir por WhatsApp
          </a>
        ) : (
          <a href="/crear" class="boton boton-oro">
            Pedir el mío
          </a>
        )}
      </div>
    </div>
  </section>
</Base>
