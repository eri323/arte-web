---
import Base from '../layouts/Base.astro';
import Montaje from '../components/catalogo/Montaje.astro';
import Vitrina, { ImagenDiseno } from '../components/catalogo/Vitrina';
import { negocio } from '../config/negocio';
import { etiquetaMedida } from '../lib/formato';
import { urlWhatsApp } from '../lib/whatsapp';

const { vitrina, catalogo } = negocio;
const porId = (id: string) => catalogo.find((d) => d.id === id) ?? catalogo[0];

// El abanico de la portada: siete diseños del catálogo, el del centro adelante.
const abanico = [2, 10, 4, 0, 6, 8, 1]
  .map((i) => catalogo[i])
  .filter((d) => d !== undefined)
  .map((diseno, k, lista) => {
    const i = k - Math.floor(lista.length / 2);
    return { diseno, i, z: 10 - Math.abs(i) };
  });

const porArea = [...negocio.medidas].sort((a, b) => a.anchoCm * a.altoCm - b.anchoCm * b.altoCm);
const menor = porArea[0];
const mayor = porArea[porArea.length - 1];

// SUPUESTO: montajes de ejemplo con diseños del catálogo, mientras el taller no tenga fotos de
// clientes. Paredes y muebles inventados.
const montajes = [
  {
    diseno: porId('no-pares'),
    pie: '60×80 · acrílico · cuarto con LED',
    mueble: 'cama',
    pared: '#1a1513',
    led: true,
    anchoCuadro: 22,
  },
  {
    diseno: porId('sakura'),
    pie: '45×60 · MDF · sala',
    mueble: 'sofa',
    pared: '#2b2a26',
    anchoCuadro: 26,
  },
  {
    diseno: porId('lado-a'),
    pie: '30×40 · MDF · estudio',
    mueble: 'escritorio',
    pared: '#16181a',
    led: true,
    anchoCuadro: 22,
  },
] as const;

const pasos = [
  {
    titulo: 'Eliges',
    texto: 'Un diseño del catálogo o tu propia foto, en la medida y el acabado que quieras.',
  },
  {
    titulo: 'Lo fabricamos',
    texto: 'Impresión y corte en MDF o acrílico, a mano y revisado antes de empacar.',
  },
  {
    titulo: 'Te llega',
    texto: 'Empacado y enviado a cualquier ciudad de Colombia. Lo coordinas por WhatsApp.',
  },
];

const preguntas = [
  {
    p: '¿Qué foto sirve?',
    r: 'Casi cualquier foto del celular. Al subirla te mostramos si la calidad es buena, regular o baja para la medida que elijas, y cuál es la medida más grande que queda bien.',
  },
  {
    p: '¿Mi foto se sube a algún servidor?',
    r: 'No. La foto se procesa en tu propio celular o computador. Cuando confirmas el pedido, la adjuntas tú mismo en el chat de WhatsApp.',
  },
  {
    p: '¿Cómo se paga?',
    r: `Pagas un abono del ${negocio.pagos.porcentajeAbono}% para empezar y el resto cuando el cuadro esté listo, antes del envío. El taller te indica los medios de pago por WhatsApp.`,
  },
  {
    p: '¿Cuánto cuesta el envío?',
    r: `${negocio.envio.texto}. Enviamos a todo Colombia.`,
  },
  {
    p: '¿Cómo sé en qué va mi pedido?',
    r: 'Con tu número de pedido puedes consultar el estado, los pagos, el saldo y las notas del taller en la página de seguimiento.',
  },
];

const abono = negocio.pagos.porcentajeAbono;
// Con número de WhatsApp el cierre abre el chat; en modo demo lleva al configurador.
const chat = urlWhatsApp(negocio.whatsapp.numero, `Hola ${negocio.marca.nombre}, quiero un cuadro`);
const fotoEjemplo = porId('ronin');

const tituloSeccion = 'font-display text-[clamp(2.5rem,6vw,4.75rem)]';
---

<Base title="Cuadros en MDF y acrílico" description={`${vitrina.titular} ${vitrina.bajada}`}>
  {/* 1 · Portada: el texto a la izquierda y los cuadros colgados sobre una tira LED. */}
  <section class="relative overflow-hidden" aria-labelledby="portada-titulo">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-[clamp(40px,7vw,96px)] lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-6 lg:pb-10">
      <div>
        <h1 id="portada-titulo" class="texto-cartel entra-subiendo max-w-[9ch]">
          {vitrina.titular}
        </h1>
        <p
          class="entra-subiendo mt-6 max-w-[40ch] text-[clamp(1.0625rem,1.6vw,1.25rem)] leading-relaxed text-texto-suave"
          style="--retraso: 120ms"
        >
          {vitrina.bajada}
        </p>
        <div
          class="entra-subiendo mt-8 flex flex-wrap items-center gap-x-6 gap-y-3"
          style="--retraso: 200ms"
        >
          <a href="#catalogo" class="boton boton-oro">
            Ver catálogo
          </a>
          <a href="/crear" class="enlace-fuerte">
            Tengo mi propia foto
          </a>
        </div>
      </div>

      {/* Los cuadros, colgados en la pared; debajo, la tira LED que los ilumina. */}
      <div class="relative pb-14">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-[-20%] bottom-0 h-[70%] bg-[radial-gradient(ellipse_45%_40%_at_50%_88%,rgb(255_45_32/.26),transparent_72%)]"
        ></div>
        <ul
          class="abanico relative h-[calc(var(--cw)*1.9)] w-full [--cw:clamp(84px,23vw,128px)] [--sep:min(9vw,48px)] lg:[--cw:clamp(120px,12vw,170px)] lg:[--sep:min(5vw,70px)]"
          aria-label="Diseños del catálogo"
        >
          {abanico.map(({ diseno, i, z }) => (
            <li
              class="carta absolute top-[4%] left-1/2 w-(--cw) -ml-[calc(var(--cw)/2)]"
              style={`--i:${i};--i2:${i * i};--z:${z};transition-delay:${Math.abs(i) * 60}ms`}
            >
              <a href="#pared" data-diseno={diseno.id} class="block">
                <span class="alza sombra-cuadro block aspect-[3/4]">
                  <ImagenDiseno diseno={diseno} decorativa />
                  <span class="sr-only">Ver {diseno.nombre} en mi pared</span>
                </span>
                <span
                  aria-hidden="true"
                  class="tip absolute -bottom-8 left-1/2 -translate-x-1/2 text-sm font-bold whitespace-nowrap text-texto"
                >
                  {diseno.nombre}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div
          aria-hidden="true"
          class="tira-led absolute inset-x-[6%] bottom-6 h-[3px] rounded-full bg-led"
        ></div>
      </div>
    </div>
  </section>

  {/* 2 y 3 · Catálogo con filtros y la pared a escala (una sola isla: comparten el diseño elegido). */}
  <Vitrina client:idle />

  {/* 4 · Personalizado: de la foto del celular al cuadro colgado. */}
  <section id="personalizado" aria-labelledby="perso-titulo" class="py-[clamp(4.5rem,10vw,8rem)]">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 md:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 id="perso-titulo" class={tituloSeccion}>
          ¿Tienes tu propia foto?
        </h2>
        <p class="mt-5 max-w-[46ch] text-texto-suave">
          Tu artista, tu película, tu carro o tu mascota. La subes, la recortas y te decimos si
          tiene calidad para la medida que quieres, antes de pedir. La foto no sale de tu celular.
        </p>
        <a href="/crear" class="boton boton-oro mt-8">
          Crear con mi foto
        </a>
      </div>
      {fotoEjemplo && (
        <div aria-hidden="true" class="grid grid-cols-[0.8fr_auto_1fr] items-center gap-4 sm:gap-6">
          <div class="rounded-[26px] border-[6px] border-[#26221f] bg-[#26221f] shadow-[0_30px_50px_-20px_#000]">
            <div class="aspect-[9/17] overflow-hidden rounded-[20px]">
              <ImagenDiseno diseno={fotoEjemplo} decorativa />
            </div>
          </div>
          <span class="font-display text-4xl text-texto-suave">→</span>
          <div>
            <div class="sombra-acrilico relative aspect-[3/4]">
              <ImagenDiseno diseno={fotoEjemplo} decorativa />
              <span class="pointer-events-none absolute inset-0 bg-linear-[115deg] from-transparent from-40% via-white/20 via-48% to-transparent to-56%" />
            </div>
            <p class="lapiz mt-3 text-texto-suave">60×80 cm · acrílico</p>
          </div>
        </div>
      )}
    </div>
  </section>

  {/* 5 · Cómo lo hacemos: tres pasos en fila, sin cajas. */}
  <section
    id="proceso"
    aria-labelledby="como"
    class="border-t border-linea bg-superficie py-[clamp(4.5rem,10vw,8rem)]"
  >
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="como" class={tituloSeccion}>
        Así nace tu cuadro
      </h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {pasos.map((paso, i) => (
          <li class="aparece border-t-2 border-texto pt-5">
            <span aria-hidden="true" class="font-display block text-6xl text-texto-suave">
              {i + 1}
            </span>
            <h3 class="mt-3 text-2xl font-extrabold">{paso.titulo}</h3>
            <p class="mt-2 max-w-[34ch] text-texto-suave">{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 6 · Así quedan: montajes de ejemplo; aquí van las fotos de clientes. */}
  <section id="clientes" aria-labelledby="clientes-titulo" class="py-[clamp(4.5rem,10vw,8rem)]">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <h2 id="clientes-titulo" class={tituloSeccion}>
          Así quedan colgados
        </h2>
        <p class="max-w-[42ch] text-sm text-texto-suave">
          Montajes de ejemplo con diseños del catálogo. En la versión del taller aquí van las fotos
          que mandan los clientes.
        </p>
      </div>
      <div class="mt-10 grid gap-x-4 gap-y-8 md:grid-cols-[1.4fr_1fr] md:grid-rows-2">
        {montajes.map((m, i) =>
          m.diseno ? (
            <Montaje
              diseno={m.diseno}
              pie={m.pie}
              mueble={m.mueble}
              pared={m.pared}
              led={'led' in m ? m.led : false}
              anchoCuadro={m.anchoCuadro}
              class={i === 0 ? 'md:row-span-2 md:[&>div]:min-h-[30rem]' : ''}
            />
          ) : null,
        )}
      </div>
    </div>
  </section>

  {/* 7 · Pagos y envíos: la barra 50/50 explica el pago sin párrafos. */}
  <section
    aria-labelledby="pagos"
    class="border-y border-linea bg-superficie py-[clamp(4.5rem,10vw,8rem)]"
  >
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="pagos" class={tituloSeccion}>
        Pagas {abono}% y {100 - abono}%
      </h2>
      <div class="aparece mt-10 flex min-h-28 text-base sm:text-lg" role="list">
        <div
          role="listitem"
          class="flex flex-col justify-between rounded-l-sm bg-acento p-4 text-sobre-acento sm:p-6"
          style={{ width: `${abono}%` }}
        >
          <span class="font-display text-4xl sm:text-6xl">{abono}%</span>
          <span class="mt-3 font-bold">Para empezar tu cuadro</span>
        </div>
        <div
          role="listitem"
          class="flex flex-col justify-between rounded-r-sm border-2 border-linea-fuerte p-4 sm:p-6"
          style={{ width: `${100 - abono}%` }}
        >
          <span class="font-display text-4xl sm:text-6xl">{100 - abono}%</span>
          <span class="mt-3 font-bold">Cuando esté listo, antes de enviarlo</span>
        </div>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        <p class="max-w-[42ch] text-texto-suave">
          Cada pago queda registrado y lo ves en el{' '}
          <a
            href="/seguimiento"
            class="font-bold text-texto underline decoration-acento underline-offset-4"
          >
            seguimiento de tu pedido
          </a>
          .
        </p>
        <div>
          <h3 class="text-xl font-extrabold">Envíos a todo Colombia</h3>
          <p class="mt-1 text-texto-suave">{negocio.envio.texto}.</p>
        </div>
      </div>
    </div>
  </section>

  {/* 8 · Preguntas frecuentes. */}
  <section aria-labelledby="faq" class="py-[clamp(4.5rem,10vw,8rem)]">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-[1fr_1.6fr]">
      <h2 id="faq" class={tituloSeccion}>
        Preguntas frecuentes
      </h2>
      <div class="divide-y divide-linea-fuerte border-y border-linea-fuerte">
        {preguntas.map(({ p, r }) => (
          <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-lg font-bold [&::-webkit-details-marker]:hidden">
              {p}
              <span
                aria-hidden="true"
                class="font-display text-3xl text-acento-fuerte transition-transform duration-300 ease-expo group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="max-w-[60ch] pb-5 text-texto-suave">{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* 9 · Cierre: una pregunta, un botón y otra vez la tira LED. */}
  <section aria-labelledby="cierre" class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pt-[clamp(4rem,12vw,8rem)] pb-[clamp(5rem,13vw,9rem)]">
      <h2 id="cierre" class="texto-cartel max-w-[10ch]">
        ¿Cuál va en tu pared?
      </h2>
      <p class="mt-5 max-w-[44ch] text-texto-suave">
        Medidas de {menor && etiquetaMedida(menor)} a {mayor && etiquetaMedida(mayor)} cm, en MDF o
        acrílico, con envío a todo Colombia.
      </p>
      {chat ? (
        <a href={chat} target="_blank" rel="noopener" class="boton boton-oro mt-8">
          Escribir por WhatsApp
        </a>
      ) : (
        <a href="/crear" class="boton boton-oro mt-8">
          Crear mi cuadro
        </a>
      )}
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-[radial-gradient(ellipse_45%_80%_at_50%_100%,rgb(255_45_32/.22),transparent_70%)]"
    ></div>
    <div
      aria-hidden="true"
      class="tira-led absolute inset-x-[10%] bottom-8 h-[3px] rounded-full bg-led"
    ></div>
  </section>
</Base>
