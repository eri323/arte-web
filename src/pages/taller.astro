---
import Base from '../layouts/Base.astro';
import Taller from '../components/taller/Taller';
---

<Base
  title="Panel del taller"
  description="Panel demo del taller: estados de los pedidos, pagos, notas y precios."
  ogImage="/og/inicio.png"
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="mx-auto max-w-[1240px] px-4 pt-[clamp(32px,5vw,64px)] pb-16">
    <h1 class="titulo-seccion mb-6">Panel del taller</h1>
    <Taller client:load />
  </section>
</Base>
