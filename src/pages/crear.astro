---
import Base from '../layouts/Base.astro';
import Encargo from '../components/configurador/Encargo';
import { negocio } from '../config/negocio';
---

<Base
  title="Tu carro o tu moto, en un póster"
  description="Cuéntanos qué carro o qué moto quieres, elige el estilo y la medida, y mira un boceto antes de pedir. Lo ilustramos a mano y te llega enmarcado."
  ogImage="/og/crear.png"
>
  <section class="mx-auto max-w-[1240px] px-4 pt-[clamp(32px,5vw,64px)] pb-20">
    <h1 class="titulo-seccion">El tuyo, tal cual</h1>
    <p class="mt-4 mb-10 max-w-[56ch] text-[1.0625rem] text-texto-suave">
      Ilustramos el vehículo que quieras, el tuyo o el de tus sueños. {negocio.tiempos.texto}.
    </p>
    <Encargo client:load />
  </section>
</Base>
