---
import Base from '../layouts/Base.astro';
import EscenaPared from '../components/escena/EscenaPared';
import TablaPrecios from '../components/formatos/TablaPrecios';
import { negocio } from '../config/negocio';
import { etiquetaMedida } from '../lib/formato';

// Un contorno por tamaño: 35×50 existe con vidrio y con acrílico y se dibuja una sola vez.
const vistos = new Set<string>();
const contornos = negocio.medidas
  .filter((m) => m.linea === 'catalogo' && !m.panoramica)
  .filter((m) => {
    const clave = `${m.anchoCm}x${m.altoCm}`;
    if (vistos.has(clave)) return false;
    vistos.add(clave);
    return true;
  })
  .map((m) => ({ anchoCm: m.anchoCm, altoCm: m.altoCm, etiqueta: etiquetaMedida(m) }));
---

<Base
  title="Medidas y precios"
  description="Medidas y precios de los pósters enmarcados de RaceTrack Posters: del catálogo y personalizados, con vidrio o acrílico, y el costo del envío por ciudad."
  ogImage="/og/formatos.png"
>
  <section class="mx-auto max-w-[1240px] px-4 pt-[clamp(32px,5vw,64px)] pb-14">
    <h1 class="titulo-seccion">Medidas y precios</h1>
    <p class="mt-4 mb-10 max-w-[60ch] text-[1.0625rem] text-texto-suave">
      Todos llegan enmarcados, con marco negro y el frente en vidrio o en acrílico. El precio es el
      mismo en vertical y en horizontal.
    </p>
    <TablaPrecios client:idle />
  </section>

  <section aria-labelledby="envios" class="mx-auto max-w-[1240px] px-4 pb-16">
    <h2 id="envios" class="font-display text-[2rem]">
      Envíos y tiempos
    </h2>
    <div class="mt-4 grid gap-x-14 gap-y-8 lg:grid-cols-2">
      <dl class="border-t-2 border-texto">
        {negocio.envio.tarifas.map((t) => (
          <div class="flex justify-between gap-6 border-b border-linea py-3">
            <dt>{t.zona}</dt>
            <dd class="font-semibold whitespace-nowrap tabular-nums">{t.valor}</dd>
          </div>
        ))}
      </dl>
      <div class="max-w-[52ch] text-texto-suave">
        <p>
          {negocio.tiempos.texto}. {negocio.tiempos.grande}.
        </p>
        <p class="mt-3">
          Empiezas con el {negocio.pagos.porcentajeAbono}% y pagas el resto cuando esté listo, antes
          del envío.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="escala" class="noche">
    <div class="piano" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-4 py-14">
      <h2 id="escala" class="titulo-seccion">
        Los tamaños, a escala
      </h2>
      <p class="mt-3 max-w-prose text-texto-suave">
        Cada contorno es una medida en vertical, sobre un sofá de 200 cm de ancho.
      </p>
      <div class="mt-8 max-w-3xl">
        <EscenaPared
          contornos={contornos}
          titulo="Comparación a escala de las medidas sobre un sofá de 200 cm"
        />
      </div>
      <a href="/#catalogo" class="boton boton-oro mt-8">
        Ver el catálogo
      </a>
    </div>
  </section>
</Base>
